<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/ssidField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_prefix"
        android:inputType="text"
        android:textColor="@color/text_primary" />

    <EditText
        android:id="@+id/passField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_pass"
        android:inputType="textPassword"
        android:textColor="@color/text_primary" />

    <CheckBox
        android:id="@+id/showPass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/show_password" />

    <EditText
        android:id="@+id/ipField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_ip"
        android:inputType="text"
        android:textColor="@color/text_primary" />

    <CheckBox
        android:id="@+id/tcCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:checked="true"
        android:text="@string/transaction_complete" />

    <CheckBox
        android:id="@+id/retryCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/auto_retry" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="0.08"
        android:text="@string/language"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <RadioGroup
        android:id="@+id/langGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/langEn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lang_en" />

        <RadioButton
            android:id="@+id/langIw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="@string/lang_iw" />
    </RadioGroup>
</LinearLayout>