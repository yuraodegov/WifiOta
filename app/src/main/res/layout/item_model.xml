<?xml version="1.0" encoding="utf-8"?>
<!-- One row in the device list: photo slot, name, folder hint. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- The real image is set in showModels(); tools:src is preview only. -->
    <ImageView
        android:id="@+id/modelPhoto"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_photo_placeholder"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        tools:src="@drawable/photo_tamar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/modelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Tamar" />

        <TextView
            android:id="@+id/modelSubtitle"
            android:layout_width="108dp"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            tools:text="תמר" />

        <TextView
            android:id="@+id/modelFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="folder: tamar" />
    </LinearLayout>

    <TextView
        android:id="@+id/modelBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/ok"
        android:textSize="12sp"
        tools:text="CONNECTED" />
</LinearLayout>







